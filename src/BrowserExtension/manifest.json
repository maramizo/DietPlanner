{
  "manifest_version": 3,
  "name": "DietPlanner Recipe Importer",
  "version": "1.0.0",
  "description": "Send the current recipe page to the DietPlanner Windows app.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Add recipe to DietPlanner",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
